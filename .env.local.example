# ─────────────────────────────────────────────────────────────────────────────
# GenieCommande — configuration dev local
# 1. Copier : cp .env.local.example .env.local
# 2. Renseigner votre email dans DEV_ACTOR et APP_ADMIN_USERS
# 3. Renseigner DATABRICKS_TOKEN (token perso depuis Databricks workspace)
# 4. Lancer : make dev
# ─────────────────────────────────────────────────────────────────────────────

# ── Identité dev (remplacer par votre email Bosch) ────────────────────────────
DEV_ACTOR=prenom.nom@bosch.com
APP_ADMIN_USERS=prenom.nom@bosch.com

# ── Auth locale ───────────────────────────────────────────────────────────────
ENABLE_PROFILE_LOGIN=true
APP_PROFILE_LOGIN_PASSWORD=admin123
APP_REQUIRE_AUTH=false
N8N_PROJECT_ROOT=

# ── SFTP local (renseigner dans .env.local, jamais committer le mot de passe) ─
SFTP_ENABLED=true
SFTP_HOST=sftp.intranet.bosch.com
SFTP_PORT=22
SFTP_USERNAME=sftp_vtb_edipushbot
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/inbox
SFTP_PRIVATE_KEY_PATH=
SFTP_PRIVATE_KEY_PASSPHRASE=

# ── LLM Databricks (requis pour l'extraction IA) ─────────────────────────────
# Récupérer depuis : Databricks workspace → Settings → Developer → Access tokens
DATABRICKS_HOST=https://adb-5555213114570927.7.azuredatabricks.net
DATABRICKS_TOKEN=
DATABRICKS_MODEL_ENDPOINT=databricks-gpt-oss-120b

# ── EDI ───────────────────────────────────────────────────────────────────────
EDIFACT_PROFILE=ELM_STANDARD
EDIFACT_SYNTAX=D96A
UNB_SENDER_GLN=4399901876613
UNB_RECEIVER_GLN=3015981600108

# ── Chemins (gérés automatiquement par docker-compose.dev.yml) ────────────────
# Ne pas modifier sauf besoin spécifique.
MASTERDATA_SOURCE_DIR=data/masterdata
INTAKE_DIR=data/intake

# Sync masterdata depuis Bosch GHE (nécessite git dans l'image + PAT)
MASTERDATA_AUTO_SYNC=true
MASTERDATA_REPO_URL=https://github.boschdevcloud.com/RSR1DY/masterdata.git
MASTERDATA_REPO_BRANCH=main
MASTERDATA_GIT_TOKEN=
