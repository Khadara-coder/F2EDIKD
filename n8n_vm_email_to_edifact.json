{
  "name": "F2EDI - Convertir PDF en EDIFACT",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Convertir un PDF en EDIFACT",
        "formDescription": "Déposez votre bon de commande PDF pour le convertir en message EDIFACT.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Fichier PDF",
              "fieldType": "file",
              "requiredField": true,
              "acceptFileTypes": ".pdf",
              "multipleFiles": false
            }
          ]
        },
        "options": {
          "respondWith": "text",
          "responseText": "✅ Fichier reçu - conversion en cours. Consultez le statut dans l'interface File2EDI."
        }
      },
      "id": "form-trigger-001",
      "name": "Formulaire: déposer un PDF",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        180,
        260
      ],
      "webhookId": "form-upload-edifact-dev"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\n\nfor (const item of items) {\n  const binary = item.binary || {};\n  for (const [key, value] of Object.entries(binary)) {\n    const fileName = String((value && value.fileName) || '').trim();\n    const mimeType = String((value && value.mimeType) || '').toLowerCase();\n    const isPdf = mimeType.includes('pdf') || /\\.pdf$/i.test(fileName);\n    if (!isPdf) {\n      continue;\n    }\n    out.push({\n      json: {\n        ...item.json,\n        sourceBinaryKey: key,\n        originalFileName: fileName || 'commande.pdf'\n      },\n      binary: {\n        document: value\n      }\n    });\n  }\n}\n\nreturn out;"
      },
      "id": "explode-pdf-001",
      "name": "Explode PDF attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://adv.bosch-homecomfort.com/api/proxy/convert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "document"
            },
            {
              "name": "source",
              "value": "n8n"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "file2edi-api-key",
          "name": "File2EDI API Key"
        }
      },
      "id": "api-convert-001",
      "name": "API: convert PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-accepted-001",
              "leftValue": "={{ $json.rejection ? $json.rejection.decision : '' }}",
              "rightValue": "ACCEPTED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-accepted-node",
