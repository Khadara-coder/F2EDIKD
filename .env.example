# ============================================================
# File2EDI + EDIFACT — environment template
# Copy to .env and fill in secrets before running
# ============================================================

# ── API runtime ───────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DATABRICKS_APP_PORT=8000
LOG_LEVEL=INFO

# ── File2EDI UI (React SPA in frontend/dist) ─────────────────────────────────
VITE_API_PROXY=http://localhost:8000

# ── Storage paths ─────────────────────────────────────────────
DATA_DIR=./data
DB_PATH=./data/edifact_standalone.db
INTAKE_DIR=./data/intake
PROCESSED_DIR=./data/processed
REJECT_DIR=./data/reject
OUTBOX_DIR=./data/outbox
LOG_DIR=./data/logs

# ── Master data ───────────────────────────────────────────────
MASTER_DATA_DIR=./data/masterdata
MASTERDATA_SOURCE_DIR=./data/masterdata
MASTERDATA_RUNTIME_DIR=./data/masterdata

# Sync masterdata : préférer n8n (voir n8n_masterdata_github_sync.json)
# Webhook déclenché par le bouton Synchroniser (URL aussi dans Paramètres admin)
MASTERDATA_N8N_WEBHOOK_KEY=
# URL vue depuis le conteneur API (localhost ne marche pas en Docker)
# MASTERDATA_N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/masterdata-sync
# Fallback Git in-process (si n8n désactivé / from_repo=true)
MASTERDATA_AUTO_SYNC=false
MASTERDATA_AUTO_SYNC_INTERVAL_HOURS=24
MASTERDATA_REPO_URL=https://github.boschdevcloud.com/RSR1DY/masterdata.git
MASTERDATA_REPO_BRANCH=main
MASTERDATA_GIT_TOKEN=
MASTERDATA_NOTIFY_API_URL=http://127.0.0.1:8000/api/masterdata/reload-cache
MASTERDATA_NOTIFY_API_KEY=

# ── Worker (standalone orchestrator — docker-compose.yml) ───
WORKER_POLL_SECONDS=5

# ── Databricks SQL Warehouse (backend only — never expose to browser)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=file2edi
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_PERSIST_PATH=
DATABRICKS_MODEL_ENDPOINT=databricks-gpt-oss-120b

# ── SFTP delivery ─────────────────────────────────────────────
SFTP_ENABLED=false
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_REMOTE_DIR=

# ── Notifications ─────────────────────────────────────────────
REJECTION_SEND_EMAIL=false
SMTP_HOST=

# ── Local Docker mock (skip Databricks SQL when true) ─────────
MOCK_MODE=false
