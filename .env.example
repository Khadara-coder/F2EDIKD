# ============================================================
# File2EDI + EDIFACT — environment template
# Copy to .env and fill in secrets before running
# ============================================================

# ── API runtime ───────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DATABRICKS_APP_PORT=8000
LOG_LEVEL=INFO
MOCK_MODE=false
ENABLE_PROFILE_LOGIN=true
APP_REQUIRE_AUTH=true
APP_PROFILE_LOGIN_PASSWORD=change-me
APP_ADMIN_USERS=admin@example.com
APP_API_KEYS=
APP_API_ACTOR=n8n
APP_API_ROLE=adv

# ── Proxy sortant (si le réseau local l'exige) ────────────────
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
NO_PROXY=localhost,127.0.0.1,postgres
no_proxy=localhost,127.0.0.1,postgres

# ── File2EDI UI (React SPA in frontend/dist) ─────────────────────────────────
VITE_API_PROXY=http://localhost:8000

# ── Storage paths ─────────────────────────────────────────────
DATA_DIR=./data
DB_PATH=./data/edifact_standalone.db
INTAKE_DIR=./data/intake
PROCESSED_DIR=./data/processed
REJECT_DIR=./data/reject
OUTBOX_DIR=./data/outbox
LOG_DIR=./data/logs
PDF_STORAGE_DIR=./data/pdf

# ── PostgreSQL (mandatory for File2EDI) ───────────────────────
PG_DATABASE_URL=postgresql+psycopg://edifact:edifact_dev_password@postgres:5432/edifact_quality
FILE2EDI_POSTGRES_STRICT=true
POSTGRES_PORT=5432
FILE2EDI_PORT=8080

# ── Master data ───────────────────────────────────────────────
MASTER_DATA_DIR=./data/masterdata
MASTERDATA_SOURCE_DIR=./data/masterdata
MASTERDATA_RUNTIME_DIR=./data/masterdata

# Sync masterdata : n8n webhook (bouton Synchroniser) ou import CSV/Parquet admin
MASTERDATA_N8N_WEBHOOK_KEY=
# URL vue depuis le conteneur API (localhost ne marche pas en Docker)
# Local (même URL avec API Docker) : http://localhost:5678/webhook/masterdata-sync
# MASTERDATA_N8N_WEBHOOK_URL=http://localhost:5678/webhook/masterdata-sync
# Prod : https://i1-d.n8n.bosch.com/webhook/masterdata-sync-prod
MASTERDATA_REPO_URL=https://github.boschdevcloud.com/RSR1DY/masterdata.git
MASTERDATA_REPO_BRANCH=main
MASTERDATA_GIT_TOKEN=
MASTERDATA_NOTIFY_API_URL=http://127.0.0.1:8000/api/masterdata/reload-cache
MASTERDATA_NOTIFY_API_KEY=

# ── Worker (standalone orchestrator — docker-compose.yml) ───
WORKER_POLL_SECONDS=5

# ── Databricks SQL Warehouse (backend only — never expose to browser)
DATABRICKS_HOST=
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=file2edi
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_PERSIST_PATH=
DATABRICKS_MODEL_ENDPOINT=databricks-gpt-oss-120b
DATABRICKS_CONFIG_PROFILE=
F2EDI_LLM_PROVIDER=databricks
F2EDI_LLM_ENABLED=1

# ── SFTP delivery ─────────────────────────────────────────────
SFTP_ENABLED=false
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_REMOTE_DIR=
SFTP_MAX_RETRIES=3
# Délai mini avant un renvoi SAP (secondes). 0 = désactivé. Admin peut forcer avec ignoreCooldown.
SAP_RESEND_COOLDOWN_SECONDS=300

# ── Masterdata n8n (prod) ─────────────────────────────────────
# Override the admin-settings webhook if the API cannot use the UI URL (DNS).
# Prod path must be masterdata-sync-prod (not masterdata-sync).
# MASTERDATA_N8N_WEBHOOK_URL=https://i1-d.n8n.bosch.com/webhook/masterdata-sync-prod
# MASTERDATA_N8N_WEBHOOK_KEY=

# ── Notifications ─────────────────────────────────────────────
REJECTION_SEND_EMAIL=false
SMTP_HOST=

# ── n8n / masterdata ──────────────────────────────────────────
N8N_PROJECT_ROOT=
MASTERDATA_AUTO_SYNC=false
MASTERDATA_STALE_HOURS=25
